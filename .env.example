# ==========================================
# TRUTHCHAIN — Environment Configuration Example
# ==========================================

# Database
# Production (Render PostgreSQL): postgresql://user:pass@host:5432/truthchain
# Local Development (SQLite): sqlite:///./truthchain.db
DATABASE_URL=sqlite:///./truthchain.db

# Groq Cloud LLM Integration
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# External Search Service (Tavily API or DuckDuckGo Fallback)
SEARCH_API_KEY=
SEARCH_MAX_RESULTS=5

# OCR Configuration (RapidOCR - Pure Python ONNX)
OCR_PROVIDER=rapidocr

# Application & CORS Settings
CORS_ORIGINS=http://localhost:3000,http://localhost:3005

# Frontend Configuration (Used by Next.js client)
NEXT_PUBLIC_API_URL=http://localhost:8000/api
